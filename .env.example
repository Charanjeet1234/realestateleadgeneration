# ─────────────────────────────────────────────────────────────
# PropEngine UAE — environment variables
# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# PostgreSQL. On Vercel use Neon (Vercel Marketplace → Neon) or Supabase.
# DATABASE_URL = pooled connection (used by the app at runtime)
# DIRECT_URL   = direct, non-pooled connection (used by migrations)
DATABASE_URL="postgresql://user:password@host:5432/propengine?sslmode=require"
DIRECT_URL=""
# Max connections per serverless instance
DB_POOL_MAX="5"

# ── Auth (required) ──────────────────────────────────────────
# Long random string, min 32 chars:  openssl rand -base64 48
JWT_SECRET=""

# First admin account — created by `npm run db:seed` if it doesn't exist.
# Sign in, then change the password from the CRM.
ADMIN_EMAIL="you@yourdomain.ae"
ADMIN_PASSWORD=""
ADMIN_NAME="Agency Admin"

# ── App ──────────────────────────────────────────────────────
APP_URL="https://your-domain.ae"
AGENCY_NAME="PropEngine UAE"

# ── AI Sales Assistant (optional — falls back to canned answers) ─
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ── Lead handling ────────────────────────────────────────────
# Round-robin new leads across active agents (true/false)
LEAD_AUTO_ASSIGN="true"
# Same email/phone within N hours is merged into the existing lead
LEAD_DEDUPE_HOURS="72"
# Max lead submissions per visitor IP per 15 minutes
LEAD_MAX_PER_IP="5"
# Budget at/above this (AED) auto-flags the lead VIP
LEAD_VIP_BUDGET_AED="5000000"
# Email the client an acknowledgement (needs SMTP below)
LEAD_AUTOREPLY="false"

# ── Instant alerts: email (any SMTP — Resend, SES, Google Workspace, Zoho…) ─
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PropEngine Leads <leads@your-domain.ae>"
# Comma-separated; the assigned agent is always emailed too
LEAD_ALERT_EMAILS="sales@your-domain.ae"

# ── Instant alerts: WhatsApp via Twilio (optional) ───────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Your Twilio WhatsApp sender, e.g. +14155238886 (sandbox) or your approved number
TWILIO_WHATSAPP_FROM=""
# Comma-separated E.164 numbers; the assigned agent's phone is added automatically
LEAD_ALERT_WHATSAPP="+971500000000"

# ── Webhook (optional) — POST each lead to Zapier / Make / another CRM ─
LEAD_WEBHOOK_URL=""
# If set, requests carry X-PropEngine-Signature: HMAC-SHA256(body)
LEAD_WEBHOOK_SECRET=""

# ── DLD market data (nightly sync) ───────────────────────────
# Vercel Cron calls /api/cron/dld-sync nightly with this secret. Any long random text:
#   openssl rand -base64 32
# Without it the nightly sync is off ("Run sync now" in Admin still works).
CRON_SECRET=""
# Override only for testing against a mock
# DLD_BASE_URL="https://gateway.dubailand.gov.ae/open-data"
